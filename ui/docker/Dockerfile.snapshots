# syntax=docker/dockerfile:1

# Playwright base for browsers; toolchain comes from the repo pixi lockfile (same as CI).
FROM mcr.microsoft.com/playwright:v1.60.0-noble

ARG PIXI_VERSION=v0.73.0

# curl is used by the pixi installer and by start-e2e-server.sh readiness checks.
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl && \
    rm -rf /var/lib/apt/lists/* && \
    curl -fsSL https://pixi.sh/install.sh | \
      PIXI_VERSION="${PIXI_VERSION}" PIXI_BIN_DIR=/usr/local/bin PIXI_NO_PATH_UPDATE=1 bash

WORKDIR /quent

COPY pixi.toml pixi.lock ./
RUN --mount=type=cache,target=/root/.cache/rattler/cache,sharing=locked \
    pixi install --locked

COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY domains ./domains
COPY examples ./examples
COPY integrations ./integrations
COPY proto ./proto

RUN pixi run cargo build -p quent-simulator-server -p quent-query-engine-fixed

COPY ui/package.json ui/pnpm-lock.yaml ui/pnpm-workspace.yaml ./ui/
COPY ui/packages/@quent/client/package.json ./ui/packages/@quent/client/package.json
COPY ui/packages/@quent/components/package.json ./ui/packages/@quent/components/package.json
COPY ui/packages/@quent/hooks/package.json ./ui/packages/@quent/hooks/package.json
COPY ui/packages/@quent/utils/package.json ./ui/packages/@quent/utils/package.json

RUN pixi run pnpm --dir ui install --frozen-lockfile

COPY ui ./ui
