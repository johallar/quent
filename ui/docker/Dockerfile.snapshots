# syntax=docker/dockerfile:1

FROM mcr.microsoft.com/playwright:v1.60.0-noble

ARG PNPM_VERSION=11.6.0
ARG RUST_VERSION=1.91.0

ENV PATH="/root/.cargo/bin:${PATH}"

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      build-essential \
      ca-certificates \
      curl \
      pkg-config \
      protobuf-compiler && \
    rm -rf /var/lib/apt/lists/*

RUN npm install --global "pnpm@${PNPM_VERSION}" && \
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | \
      sh -s -- -y --profile minimal --default-toolchain "${RUST_VERSION}"

WORKDIR /quent

COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY domains ./domains
COPY examples ./examples
COPY proto ./proto

RUN cargo build -p quent-simulator-server -p quent-query-engine-fixed

COPY ui/package.json ui/pnpm-lock.yaml ui/pnpm-workspace.yaml ./ui/
COPY ui/packages/@quent/client/package.json ./ui/packages/@quent/client/package.json
COPY ui/packages/@quent/components/package.json ./ui/packages/@quent/components/package.json
COPY ui/packages/@quent/hooks/package.json ./ui/packages/@quent/hooks/package.json
COPY ui/packages/@quent/utils/package.json ./ui/packages/@quent/utils/package.json

RUN pnpm --dir ui install --frozen-lockfile

COPY ui ./ui
